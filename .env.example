# RVC Backstage — environment template. Copy to `.env` and fill in.
# Every variable here is validated at boot (T-003); missing required vars fail fast.

# --- app ---
APP_URL=http://localhost:3000
NODE_ENV=development

# --- database (local self-hosted Postgres; matches docker-compose defaults) ---
# compose maps the container's 5432 to host 5438 (5432-5437 are taken on the dev server)
DATABASE_URL=postgres://rvc:rvc_dev_password@localhost:5438/rvc_backstage

# --- auth (Auth.js v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me

# --- email (SMTP — transactional + digests; dev can point at mailpit) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RVC Backstage <backstage@rawvision.demo>"

# --- whatsapp channel (T-064, optional — adapter no-ops when unset) ---
# Meta Business Cloud API; Owner still to confirm the provider choice.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# --- file storage ---
UPLOADS_DIR=./uploads

# --- AI assistant (EPIC-014) ---
# Leave empty to disable the AI Assistant menu's backend (UI shows a notice).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# --- WhatsApp gateway (Baileys) ---
# Where the linked-device credentials are stored. Defaults to a folder under
# UPLOADS_DIR so they survive redeploys. Delete it to force a fresh QR scan.
WHATSAPP_SESSION_DIR=
# Country code assumed for local-format numbers (e.g. 0812… -> 62812…)
WHATSAPP_COUNTRY_CODE=62

# First-boot administrator (used once, only when the database has no users).
# Set these BEFORE running `pnpm seed`; the phone is optional and enables
# WhatsApp notifications for the account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_PHONE=
